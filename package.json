{
  "name": "rsge-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for RS.ge WayBillService (Revenue Service of Georgia electronic waybills)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rsge-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "GLOSSARY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prefecthq/fastmcp-ts": "^1.15.0",
    "fast-xml-parser": "^5.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
